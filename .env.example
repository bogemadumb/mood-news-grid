# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Под каким путём приложение видно снаружи. Пусто — корень домена.
ROOT_PATH=

# Провайдер модели: claude_cli | openai | echo
# echo — детерминированная заглушка, поднимается без ключей и без сети.
LLM_PROVIDER=echo

# Для LLM_PROVIDER=openai (z.ai, LM Studio, Ollama — любой совместимый endpoint)
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=
CLAUDE_MODEL=glm-4.6

# Живая перегенерация по кнопке. По умолчанию выключена:
# за ней стоит личная подписка автора, раздавать её посетителям нельзя.
ALLOW_LIVE_REGENERATE=0

# Подставляется скриптом выкладки, руками трогать не нужно.
GIT_SHA=dev
